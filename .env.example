PORT=8080
HOST=0.0.0.0
DATABASE_URL=./data/towteam.sqlite
NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
CORS_ORIGIN=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
ISSUE_RATE_LIMIT_WINDOW_MS=60000
ISSUE_RATE_LIMIT_MAX=10
PAGE_RATE_LIMIT_WINDOW_MS=60000
PAGE_RATE_LIMIT_MAX=600
TOW_PERMIT_TEMPLATE_PATH=./data/TowPermit.pdf
PDF_PYTHON_BIN=python3
# Generated private assets are rebuilt automatically when the template changes.
TOW_PAPER_ASSETS_PATH=./data/paper-editor-assets
# Mount a dedicated NAS share on the host and expose it to this process/container.
# The destination must contain .towteam-nas with the text towteam-paper-backup-v1.
NAS_BACKUP_ENABLED=false
NAS_PDF_PATH=/nas/towteam
# Host-side mounted folder, used only by docker-compose.nas.yml.
NAS_MOUNT_PATH=/mnt/nas/towteam
