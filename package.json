{
  "name": "towteam",
  "version": "3.0.2",
  "description": "Self-hostable aircraft tow planning, tracking, and history app.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node scripts/run-tests.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node seed/seed.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "archiver": "8.0.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "lucide-react": "^1.41.0",
    "morgan": "^1.12.1",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.8.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "ip-address": "^10.5.1",
    "shell-quote": "^1.11.0"
  },
  "engines": {
    "node": ">=24"
  }
}
